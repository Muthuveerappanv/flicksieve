{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "flicksieve",
  "version": "0.2.0",
  "identifier": "com.flicksieve",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlickSieve",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://v3.sg.media-imdb.com https://r.jina.ai https://www.omdbapi.com; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../scripts/fetch_letterboxd.py",
      "../scripts/fetch_rottentomatoes.py",
      "../scripts/scrape_91mobiles.py",
      "../scripts/discover_at_home.py",
      "../scripts/discover_indian.py",
      "../src/data/reviewers.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
