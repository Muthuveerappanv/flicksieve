{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "flicksieve",
  "version": "0.1.4",
  "identifier": "com.flicksieve",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlickSieve",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../scripts/fetch_letterboxd.py",
      "../scripts/fetch_rottentomatoes.py",
      "../scripts/scrape_91mobiles.py",
      "../scripts/discover_at_home.py",
      "../scripts/discover_indian.py",
      "../src/data/reviewers.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
